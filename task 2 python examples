# Function to calculate project cost after tax
def calculate_total_cost(cost, tax_rate):
    total = cost + (cost * tax_rate / 100)
    return total

project_cost = 50000
tax = 10

total_amount = calculate_total_cost(project_cost, tax)

print("\nProject Cost Calculation:")
print("Original Cost:", project_cost)
print("Tax Rate:", tax, "%")
print("Total Cost:", total_amount)
